# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key
SUPABASE_SECRET_KEY=your-project-secret-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_NAME=your-bucket

# NextAuth.js
# openssl rand -base64 32 명령어로 생성
NEXTAUTH_SECRET=your-secret-key-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# API 라우트 CORS 설정 (콤마로 구분)
CORS_ALLOWED_ORIGINS=http://localhost:3001