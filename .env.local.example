# ============================================
# 로컬 개발 환경 (supabase start 후 사용)
# 아래 키는 Supabase CLI가 생성하는 고정값
# 운영 환경에서는 클라우드 key로 교체하여 배포
# ============================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# ============================================
# Storage
# ============================================
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_NAME=public-assets

# ============================================
# NextAuth.js
# openssl rand -base64 32 명령어로 생성
# ============================================
NEXTAUTH_SECRET=your-secret-key-min-32-chars
NEXTAUTH_URL=http://localhost:3000