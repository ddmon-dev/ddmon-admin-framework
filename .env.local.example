# ============================================
# 로컬 개발 환경 (supabase start 후 사용)
# 아래 값은 Supabase CLI가 생성하는 고정값
# 운영 환경에서는 클라우드 값으로 교체하여 배포
# 클라이언트는 Storage/DB에 직접 접근하지 않으므로 anon(publishable) key는 불필요
# ============================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# ============================================
# Storage
# ============================================
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_NAME=public-assets

# ============================================
# NextAuth.js
# openssl rand -base64 32 명령어로 생성
# ============================================
NEXTAUTH_SECRET=your-secret-key-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# ============================================
# SMTP (이메일 발송)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="ADMIN <noreply@domain.com>"

# ============================================
# 데모 모드 (포트폴리오 공개 데모 배포용)
# true일 때: 로그인 오버레이(원클릭 접속) + 삭제·비밀번호 변경 차단 + 이메일 실발송 스킵
# 미설정/false면 일반 동작. NEXT_PUBLIC_ 이므로 값 변경 시 재빌드 필요.
# 기본 계정은 시드 슈퍼관리자(공개 데모용이라 노출 무방).
# ============================================
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_ID=admin
NEXT_PUBLIC_DEMO_PASSWORD=qwe123
