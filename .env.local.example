# ============================================
# 로컬 개발 환경 (supabase start 후 사용)
# 아래 값은 Supabase CLI가 생성하는 고정값
# 운영 환경에서는 클라우드 값으로 교체하여 배포
# 클라이언트는 Storage/DB에 직접 접근하지 않으므로 anon(publishable) key는 불필요
# ============================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# ============================================
# Storage
# ============================================
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_NAME=public-assets

# ============================================
# NextAuth.js
# openssl rand -base64 32 명령어로 생성
# ============================================
NEXTAUTH_SECRET=your-secret-key-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# ============================================
# SMTP (이메일 발송)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="ADMIN <noreply@domain.com>"

# ============================================
# 데모 모드 (포트폴리오 공개 데모 배포용)
# true일 때: 로그인 오버레이(원클릭 접속) + 삭제·비밀번호 변경 차단 + 이메일 실발송 스킵
# 미설정/false면 일반 동작. NEXT_PUBLIC_DEMO_MODE는 빌드 시 인라인되므로 값 변경 시 재빌드 필요.
#
# DEMO_ID/DEMO_PASSWORD는 NEXT_PUBLIC_ 접두사를 붙이지 않는다(서버 전용).
# authorize 콜백(서버)에서만 읽혀 클라이언트 번들에 계정정보가 실리지 않는다.
# 데모 모드(true) 배포 시 필수 — 미설정이면 원클릭 접속이 거부된다. Vercel env에도 동일 변수명으로 설정.
# 값은 시드 슈퍼관리자(admin/qwe123)를 그대로 써도 되고, 별도 데모 전용 계정을 만들어도 된다.
# ============================================
NEXT_PUBLIC_DEMO_MODE=false
DEMO_ID=admin
DEMO_PASSWORD=qwe123

# ============================================
# Vercel Cron (Supabase keep-alive 인증)
# openssl rand -base64 32 로 생성. Vercel 프로젝트 env에도 동일하게 설정하면
# cron 요청에 Authorization 헤더가 자동 주입되어 /api/cron/keep-alive가 보호됨.
# ============================================
CRON_SECRET=your-cron-secret
